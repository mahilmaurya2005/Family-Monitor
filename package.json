{
  "name": "family-monitor",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "corepack pnpm -r --parallel dev",
    "build": "corepack pnpm -r --if-present build",
    "lint": "corepack pnpm -r --if-present lint",
    "test": "corepack pnpm -r --if-present test",
    "format": "prettier --write .",
    "db:generate": "corepack pnpm --filter @family-monitor/backend prisma:generate",
    "db:migrate": "corepack pnpm --filter @family-monitor/backend prisma:migrate"
  },
  "devDependencies": {
    "@prisma/client": "^5.20.0",
    "prettier": "^3.3.3",
    "prisma": "^5.20.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  }
}
