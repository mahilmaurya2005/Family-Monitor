{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@family-monitor/types": ["packages/types/src/index.ts"],
      "@family-monitor/api-client": ["packages/api-client/src/index.ts"],
      "@family-monitor/utils": ["packages/utils/src/index.ts"]
    }
  }
}
