POSTGRES_DB=family_monitor
POSTGRES_USER=family
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_PORT=5432

DATABASE_URL=postgresql://family:replace-with-strong-postgres-password@postgres:5432/family_monitor?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-characters
WEB_ORIGIN=http://localhost:8080
NODE_ENV=production
BACKEND_PORT=4000
DASHBOARD_PORT=8080
REDIS_PORT=6379
